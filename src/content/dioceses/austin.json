  "postings": {
    "campus": {
      "label": "St. Mary's at Texas A&M",
      "school": "St. Mary's Catholic Center at Texas A&M",
      "residence": "the priests' house behind St. Mary's, a block from Northgate and across the tracks from the Corps",
      "line": "St. Mary's Catholic Center at Texas A&M: the largest campus ministry in the country by most counts, Sunday Masses that fill a church the size of a cathedral, Aggie Awakening, the Corps of Cadets in uniform in the front pews, and a vocations record no parish in the state comes near. The diocese's bishops have come out of it, and its chaplain is the most watched priest in the diocese who is not a bishop."
    },
    "hospital": {
      "school": "Ascension Seton Medical Center",
      "residence": "the chaplains' quarters at Seton, on the 38th Street side",
      "label": "Seton",
      "line": "Seton on 38th Street: the Daughters of Charity's hospital, now Ascension's, with the trauma center at Dell Seton downtown and a chaplaincy in two languages."
    },
    "prison": {
      "school": "the Gatesville units",
      "residence": "a rented room in Gatesville, by the courthouse square",
      "label": "Gatesville",
      "line": "The Gatesville units: five state prisons in one Coryell County town, most of the women in Texas prison among them, and a Catholic chaplaincy that drives from unit to unit."
    },
    "schools": {
      "school": "the Office of Catholic Schools in Austin",
      "residence": "a chancery apartment off Congress Avenue",
      "label": "the schools office",
      "line": "The diocese's schools office: twenty schools from Waco to San Marcos, full in the suburbs and fighting in the old parishes."
    }
  },
  "institutionNames": {
    "catholic_university": {
      "name": "St. Edward's University",
      "line": "the Holy Cross university on the hill in South Austin: a chaplaincy, lectures, and the city's Catholic professors"
    },
    "hospital_system": {
      "name": "Ascension Seton",
      "line": "the Daughters of Charity's hospitals, now Ascension's, across the diocese; the chaplaincies are in two languages"
    },
    "school_network": {
      "name": "the diocese's schools",
      "line": "twenty of them, full in Williamson and Hays and fighting in Waco and East Austin"
    },
    "catholic_charities": {
      "name": "Catholic Charities of Central Texas",
      "line": "the immigration clinic, the refugees, and the flood each spring"
    }
  }
