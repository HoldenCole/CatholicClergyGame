  "character": {
    "base": [
      "The second-oldest diocese in the country and the one that has never quite believed it is in the United States: French parishes on the river, Irish and Italian ones in the city, and a Black Catholic history older than the Republic.",
      "Half the priests were baptized in the parishes they now serve, and everyone is a cousin of someone in the chancery.",
      "The water is the fact of the place. Every parish has a line on a wall from 2005, and the ones that reopened are proud of it in a way outsiders find hard to read."
    ],
    "byNeed": {
      "critically_short": "The seminary on Carrollton Avenue is full of men from other dioceses, and the archdiocese's own ordination classes have been two and three.",
      "stretched": "Priests cover two parishes across the river from each other and learn the bridge schedule the way sailors learn tides.",
      "adequate": "Enough men, for now, thanks to the ones who came home after the storm and stayed.",
      "deep_bench": "More priests than anyone expected, and a personnel board that has forgotten how to say no to a request for a second parish."
    },
    "byFinancial": {
      "healthy": "The old money on St. Charles Avenue is still Catholic, still gives, and still expects to be asked in person.",
      "strained": "Parishes rebuilt on insurance money are now running on Sunday collections that never came all the way back.",
      "crisis": "The bankruptcy is the only subject at the deanery meeting, and the lawyers know the parishes better than the auxiliary does."
    },
    "byTension": {
      "one_voice": "The presbyterate argues about food and football and, on the record, about nothing else.",
      "quietly_split": "The Vietnamese parishes, the Black parishes, and the Uptown parishes each think they are the archdiocese, and each is polite about it.",
      "openly_divided": "The argument about who was protected and who was not has broken into the open, and the archbishop is quoted at both ends of it."
    }
  },
  "complications": [
    "A bankruptcy filing that has put every parish's assets under a lawyer's eye and every pastor under a spending freeze.",
    "A list of names the archdiocese published and a longer list that a newspaper says it did not.",
    "Insurance and flood maps that decide which parishes can rebuild and which will be merged, without anyone in the chancery having to say so.",
    "A seminary that trains half the South and a presbyterate that resents the graduates who leave."
  ],
  "hiddenComplications": [
    "A monsignor who kept the personnel files through three archbishops and knows what was in them.",
    "The archbishop has been told, quietly, that Rome wants a settlement before a successor is named.",
    "A river parish's insurance money that was spent on a different parish's roof."
  ],
