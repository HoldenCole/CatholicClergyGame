  "character": {
    "base": [
      "The cathedral is on the national news twice a year and the archbishop is asked about the president. Everything said from a pulpit here can be repeated in print by Monday.",
      "The parishes run from Park Avenue to the Bronx to the far end of the Hudson, and a man can spend a whole career being moved between worlds that do not speak to each other.",
      "The presbyterate is large, old, and multilingual, and it remembers every archbishop it has had."
    ],
    "byNeed": {
      "critically_short": "The archdiocese is closing parishes faster than it can announce them, and a newly ordained man is a pastor before he is ready.",
      "stretched": "Clustering and mergers are the constant subject; the personnel board meets more than it would like.",
      "adequate": "The bench is respectable, thanks to the seminary and the foreign priests the archdiocese has always been able to attract.",
      "deep_bench": "There are more priests than parishes that can use them well, and the wait for a pastorate is long."
    },
    "byFinancial": {
      "healthy": "The money is there, in endowments and in a handful of donors who expect to be called by name.",
      "strained": "The money is in the wrong places: rich parishes with no children and poor parishes with full schools.",
      "crisis": "The archdiocese has sold buildings that were never supposed to be for sale, and the settlements are not finished."
    },
    "byTension": {
      "one_voice": "Whatever the presbyterate thinks, it says with one voice, because the chancery has made clear what happens otherwise.",
      "quietly_split": "The presbyterate is split along lines that only show at clergy dinners, after the second bottle.",
      "openly_divided": "The presbyterate fights in the diocesan paper and in the secular one, and the archbishop is a party rather than a referee."
    }
  },
  "complications": [
    "A consolidation plan that will close a fifth of the parishes in ten years, with the list not yet public.",
    "A tabloid with a reporter on the religion beat who has sources in the chancery.",
    "Debt from the last capital campaign that the next one is supposed to retire.",
    "A cathedral restoration that has run over by a figure nobody will confirm."
  ],
  "hiddenComplications": [
    "A vicar general who is running the archdiocese while the archbishop travels, and who intends to keep doing so.",
    "Settlements still being negotiated from cases twenty years old, with a bankruptcy filing quietly prepared.",
    "The seminary's rector and the archbishop have not spoken privately in a year."
  ],
