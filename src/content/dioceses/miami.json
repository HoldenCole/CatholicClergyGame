  "character": {
    "base": [
      "A diocese younger than most of its pastors, built by exiles: the Cubans who came in 1961 and every wave since, and the Haitians who came by boat and stayed.",
      "Three counties and a hundred miles of Keys, with a Mass in Spanish, Creole, Portuguese, or Tagalog somewhere every hour of Sunday.",
      "The archdiocese runs its own radio station, its own seminary, and a shrine on the bay where a whole nation in exile goes to pray for a country its grandchildren have never seen."
    ],
    "byNeed": {
      "critically_short": "The parishes grow faster than the seminary can fill them, and half the presbyterate was ordained somewhere else.",
      "stretched": "Every pastor has a Spanish Mass, a Creole Mass, and a request from the chancery to add one more.",
      "adequate": "Priests from Colombia, Nigeria, and Poland fill the gaps, and the personnel board is a study in immigration law.",
      "deep_bench": "Enough men, mostly from elsewhere, and a native-born minority that watches its numbers."
    },
    "byFinancial": {
      "healthy": "The Coral Gables and Pinecrest parishes carry the diocese, and the donors like to see their names on a building.",
      "strained": "The old Cuban money is aging out, the new money is Venezuelan and cautious, and the schools cost more every year.",
      "crisis": "A hurricane, an insurance market that has fled the state, and a chancery that cannot cover the deductibles."
    },
    "byTension": {
      "one_voice": "The presbyterate agrees about the regime in Havana and defers to the archbishop on everything else.",
      "quietly_split": "Split by language more than by theology: the Anglo pastors, the Cuban pastors, and the Haitian pastors meet separately and merge at ordinations.",
      "openly_divided": "The argument about immigration has reached the pulpits, and a pastor's homily on the subject was on television by Monday."
    }
  },
  "complications": [
    "An immigration enforcement surge that has emptied the Spanish Masses of the people who most need them.",
    "A hurricane season that has already cost two parishes their roofs, and an insurer that has left the state.",
    "A shrine on the bay that is a national church for a nation in exile, and a parish that resents living in its shadow.",
    "Growth in Broward that the chancery cannot fund, and a cathedral in a neighborhood the donors will not visit."
  ],
  "hiddenComplications": [
    "A vicar general who decides which of the foreign-born priests get incardinated and which go home.",
    "A developer who wants a parish's land in Doral and has already spoken to the archbishop's brother.",
    "A Haitian pastor's complaint about the personnel board that the chancery has not answered in three years."
  ],
  "heritage": {
    "caribbean": 3,
    "central_american": 2,
    "mexican": 1,
    "irish": 1.5,
