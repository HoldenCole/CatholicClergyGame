  "character": {
    "base": [
      "Every neighborhood was once a parish and every parish was once a nation: Polish, Irish, Lithuanian, Italian, Mexican. The churches are enormous and the people who built them are buried behind them.",
      "The archdiocese has been consolidating for a generation and calls it renewal. Pastors run two or three churches and drive between them on Sunday mornings.",
      "The presbyterate is proud of a tradition of pastoral independence that the chancery finds inconvenient."
    ],
    "byNeed": {
      "critically_short": "A man is given a cluster of three parishes at five years ordained because there is no one else.",
      "stretched": "Retirements outrun ordinations every year, and the personnel board has stopped pretending otherwise.",
      "adequate": "The seminary and a steady flow of Polish and Mexican priests keep the numbers respectable.",
      "deep_bench": "A rare year: more priests than the consolidated parishes need, and the young ones wait."
    },
    "byFinancial": {
      "healthy": "The sale of closed churches has, for the moment, balanced the books.",
      "strained": "The schools are the wound: every year the archdiocese closes a few more and every closing is a fight.",
      "crisis": "Parishes are being merged by the dozen, and the reason given is the money because the truth is worse."
    },
    "byTension": {
      "one_voice": "A quiet presbyterate, disciplined by decades of the same kind of archbishop.",
      "quietly_split": "The old ethnic pastors and the new men do not disagree in public. They simply do not attend the same things.",
      "openly_divided": "A priests' association meets without the archbishop's blessing and publishes letters he has to answer."
    }
  },
  "complications": [
    "A consolidation plan, already public, that will merge half the city's parishes into 'communities' with one pastor each.",
    "Three parishes in serious financial trouble, with a fixer likely to be noticed.",
    "A school system losing enrollment at a rate the archdiocese has stopped publishing.",
    "A presbyterate at war with itself over the last archbishop's decisions."
  ],
  "hiddenComplications": [
    "The vicar for clergy keeps a private list of men he does not intend to make pastors, and the list is long.",
    "An investigation into the finances of a closed parish that the chancery is trying to keep internal.",
    "The archbishop's health is worse than the diocese knows."
  ],
