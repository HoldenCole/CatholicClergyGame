  "seminaryName": "Mundelein Seminary",
  "voice": {
    "weather": [
      "January comes off the lake sideways, and the walk from the rectory to the sacristy is the coldest part of the day.",
      "Spring arrives in a single week in May, apologizes for nothing, and is gone by the Ascension.",
      "July is wet heat off the prairie, and the old churches hold it in the brick until October.",
      "The first snow comes before Thanksgiving and the last one after Easter, and nobody here finds that remarkable."
    ],
    "sunday": [
      "Sunday is a pastor driving between two churches with a stole on the passenger seat and the homily in his head.",
      "The Polish Mass, the Spanish Mass, and the English Mass share one building and three separate coffee hours.",
      "By noon the parking lot is a Bears tailgate or a Sox argument, depending on the season and the block."
    ],
    "presbyterate": [
      "The priests of Chicago are pastors first and diocesan second, and they say so to the archbishop's face when asked.",
      "They know which neighborhood a man came from before they know his name, and they file him accordingly.",
      "Their gatherings are long dinners in rectory basements with good wine and grievances aged as carefully."
    ]
  },
