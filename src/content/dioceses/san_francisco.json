  "character": {
    "base": [
      "A small archdiocese of three counties and enormous real estate: the city, the peninsula, and Marin, with a cathedral that looks like a washing machine and a mission older than the country.",
      "The most secular city in America with a Catholic skeleton: the Irish who built it, the Italians of North Beach, the Filipinos of Daly City, and the Mission's Latinos, in parishes that are worth more as land than as parishes.",
      "The laity are to the left of the presbyterate and the archbishop is to the right of both, and everyone is polite about it until they are not."
    ],
    "byNeed": {
      "critically_short": "The seminary in Menlo Park trains men for a dozen dioceses and keeps almost none for this one.",
      "stretched": "Pastors cover a city church and a peninsula church and learn which freeway is worse at which hour.",
      "adequate": "Enough men, thanks to the Filipinos and the ones who came from Vietnam and Nigeria, and a chancery that is learning their names.",
      "deep_bench": "A surplus of priests who came for the city and stayed for the weather, and a personnel board that can afford to be particular."
    },
    "byFinancial": {
      "healthy": "The land is the endowment: a closed convent on the peninsula pays for three schools in the city.",
      "strained": "The parishes that have money are not the parishes that have people, and the chancery's transfers are watched by both.",
      "crisis": "A bankruptcy filing, a list of claims, and a chancery that is selling the parking lots first."
    },
    "byTension": {
      "one_voice": "The presbyterate is small enough to know each other's opinions and old enough not to say them.",
      "quietly_split": "Split between the men who think the archbishop is the last honest man in California and the men who think he is a guest who has stayed too long.",
      "openly_divided": "The argument has reached the op-ed pages, the pastor of Most Holy Redeemer and the pastor of Star of the Sea have both been quoted, and the archbishop has answered each in a pastoral letter."
    }
  },
  "complications": [
    "A bankruptcy filing that has put every parish's land under a lawyer's eye, and the land is the point.",
    "An archbishop the city's politicians treat as an opponent and the national press treats as a story.",
    "A cathedral on Geary that the city calls a washing machine and the chancery calls a landmark, with a parish that fits in the side chapel.",
    "Parishes in the city that are half empty and worth forty million dollars, and a finance council that has done the arithmetic."
  ],
  "hiddenComplications": [
    "A chancellor who knows which parishes will be sold and has already told a developer.",
    "The archbishop has been told Rome is considering a coadjutor and is acting as if it were not true.",
    "A Filipino pastor's complaint about the personnel board that has been in a drawer for two years."
  ],
  "heritage": {
    "irish": 3,
