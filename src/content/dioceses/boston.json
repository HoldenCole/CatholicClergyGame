  "character": {
    "base": [
      "The most Catholic city in the country for a hundred years, and the one where the collapse was public first: the archdiocese has closed a third of its parishes since the scandal and is still counting.",
      "Irish to the bone in its presbyterate and increasingly Brazilian, Haitian, Vietnamese, and Salvadoran in its pews, and the two halves are only beginning to meet.",
      "Boston College, the Globe, and the State House sit within three miles of the cathedral, and each thinks it is the archdiocese's conscience."
    ],
    "byNeed": {
      "critically_short": "Ordination classes of three and four for a diocese that once ordained forty, and collaboratives of three parishes under one pastor.",
      "stretched": "Every pastor has a second church and a third church's cemetery, and the seminary in Brighton is smaller than its parking lot.",
      "adequate": "The collaboratives have steadied things, and the men who stayed through the worst are the backbone of the place.",
      "deep_bench": "More priests than anyone expected, thanks to the Brazilians and the men who came from Redemptoris Mater, and a chancery that is learning to trust them."
    },
    "byFinancial": {
      "healthy": "The sales of the closed churches paid the settlements, and the parishes that survived are the ones that could always pay their own way.",
      "strained": "Wealthy parishes on the Gold Coast, poor ones in Lynn and Brockton, and a chancery that moves money between them under the Globe's eye.",
      "crisis": "The pension fund, the schools, and the settlements have come due at once, and the archbishop has sold the residence and will sell more."
    },
    "byTension": {
      "one_voice": "The presbyterate is chastened and careful, and the men who lived through 2002 do not argue in public.",
      "quietly_split": "Split between the men who think the collaboratives saved the diocese and the men who think they buried the parishes.",
      "openly_divided": "The argument about what was covered up and by whom has never ended, and a new name comes out every year."
    }
  },
  "complications": [
    "A newspaper that broke the scandal and still keeps a reporter on the chancery.",
    "Collaboratives: two or three parishes under one pastor, and every parish council certain it is the one being swallowed.",
    "A pension fund for the priests that was underfunded for a generation and is now the subject of a lawsuit.",
    "A cathedral in the South End that is grand, empty at nine, and full at noon in Spanish."
  ],
  "hiddenComplications": [
    "A monsignor at the chancery who kept the old personnel files and has never been asked what he remembers.",
    "The archbishop has been told that Rome wants the seminary merged with another and has not told the rector.",
    "A closed church whose sale went to a developer with a cousin on the finance council."
  ],
  "heritage": {
    "irish": 4,
