  "character": {
    "base": [
      "A diocese growing faster than it can build: new parishes on the highway ring every year, each one full before the roof is on.",
      "Latino, Vietnamese, Nigerian, Anglo, and oil money, in parishes that sometimes contain all five. The presbyterate is young, foreign, and stretched to the edge of sense.",
      "Nobody here has time for a faction. The question is not what you believe but whether you can say Mass in two languages and drive."
    ],
    "byNeed": {
      "critically_short": "A man is a pastor at three years ordained because the alternative is closing the doors, and the chancery says so plainly.",
      "stretched": "Every parish wants another priest and the archbishop answers every letter with the same regret.",
      "adequate": "The seminary is full and the numbers, for once, are moving the right way.",
      "deep_bench": "The rare year with more men than parishes, which the growth will fix by next spring."
    },
    "byFinancial": {
      "healthy": "The money is new and there is a great deal of it, and the people who have it are in the pews.",
      "strained": "Building debt: every new parish is a mortgage, and every mortgage is a decade of the pastor's life.",
      "crisis": "A hurricane year, or an oil year, and the insurance did not pay."
    },
    "byTension": {
      "one_voice": "Too busy to argue, and led by a man who does not invite it.",
      "quietly_split": "The Anglo old guard and the immigrant new guard have not yet noticed that they disagree.",
      "openly_divided": "A fight over the liturgy at the cathedral has spilled into the parishes and the archbishop is expected to end it."
    }
  },
  "complications": [
    "A clergy shortage so severe the archdiocese has stopped calling it a shortage and started calling it the situation.",
    "Two new parishes a year, each with a mortgage and a pastor who has never run a building project.",
    "A hurricane recovery that the diocese is still paying for.",
    "A Spanish-language apostolate that outnumbers the English one and has not yet been given its due."
  ],
  "hiddenComplications": [
    "A vocations director who has been admitting men the seminary would rather he did not.",
    "A donor family that expects to be consulted on assignments and, so far, has been.",
    "The archbishop is seventy-three and Rome has not answered his letter."
  ],
