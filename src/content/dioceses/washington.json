  "character": {
    "base": [
      "A small diocese with a large shadow: the nuncio lives here, the bishops' conference meets here, and half the Catholic press has an office within a mile of the cathedral.",
      "The parishes are Georgetown lawyers, Maryland suburbs, and the Black Catholic parishes of the District that the archdiocese has been rediscovering for fifty years.",
      "Every priest here is closer to Rome than he would be anywhere else in the country, and every mistake is closer too."
    ],
    "byNeed": {
      "critically_short": "Strange for a diocese this connected, but the numbers do not lie, and the nuncio has noticed.",
      "stretched": "The university and the national institutions borrow priests the parishes need.",
      "adequate": "A deep enough bench, thickened by the men who come to study and stay.",
      "deep_bench": "More priests than parishes, and a personnel board that can afford to be choosy, which it is."
    },
    "byFinancial": {
      "healthy": "The archdiocese is wealthy in the way of a city where the donors sit on boards.",
      "strained": "Wealthy parishes, poor parishes, and a chancery that has to move money between them under the eye of the press.",
      "crisis": "A scandal at the top has cost the diocese its donors and, for a season, its nerve."
    },
    "byTension": {
      "one_voice": "The presbyterate is careful, because everyone here is being watched by someone.",
      "quietly_split": "Split along the lines of the national argument, which is conducted here in person.",
      "openly_divided": "The argument is public, in the columns and on the panels, and the archbishop is quoted on both sides."
    }
  },
  "complications": [
    "A scandal working through the courts that began with a former archbishop and has not finished.",
    "A press corps that treats the chancery as a beat.",
    "A cathedral parish that hosts the funerals of the powerful and resents being a parish.",
    "The nunciature's attention, which is a compliment until it is not."
  ],
  "hiddenComplications": [
    "A monsignor at the conference who decides which priests the nuncio hears about.",
    "The archbishop is being considered for a red hat and is acting accordingly.",
    "A parish trust fund that has been quietly borrowed against."
  ],
