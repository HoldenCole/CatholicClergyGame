  "character": {
    "base": [
      "The largest diocese in the country, in a city that does not think about it. Mass is celebrated in forty languages and the cathedral is downtown, where nobody lives.",
      "The parishes are Latino first and everything else second, and a priest without Spanish is a priest with half a career.",
      "Everything is far from everything else. A brother priest is an hour away, and the chancery is a building most men see twice a year."
    ],
    "byNeed": {
      "critically_short": "Parishes of ten thousand families have two priests. A newly ordained man says six Masses on a Sunday and is asked why he looks tired.",
      "stretched": "The seminary cannot keep up, and the archdiocese leans on religious orders and foreign clergy for every third parish.",
      "adequate": "Enough men, barely, and the chancery counts the ones who will retire before it counts the ones who will be ordained.",
      "deep_bench": "An unusual stretch of vocations, mostly from the Latino parishes, has given the archdiocese room to breathe."
    },
    "byFinancial": {
      "healthy": "The collections in the immigrant parishes are small and constant and, added together, enormous.",
      "strained": "The money goes to schools that the families cannot afford and to buildings the last century built for a different city.",
      "crisis": "A settlement the size of a small country's budget, and a diocese that has learned to say 'restructuring' without wincing."
    },
    "byTension": {
      "one_voice": "The presbyterate is too spread out to fight, and mostly too busy.",
      "quietly_split": "Anglo pastors and Latino pastors, older and younger, each with their own dinners and their own opinions of the archbishop.",
      "openly_divided": "A traditionalist minority is loud and organized and the archbishop has decided to be patient with it, which nobody thanks him for."
    }
  },
  "complications": [
    "An immigration enforcement climate that has parishioners afraid to come to Mass, and a chancery that has to decide how loudly to say so.",
    "A settlement still being paid, with parishes assessed to cover it.",
    "A cathedral and its downtown that the parishes resent paying for.",
    "A seminary whose formation program is being rebuilt after a bad visitation."
  ],
  "hiddenComplications": [
    "A regional bishop with ambitions who is building his own network of pastors.",
    "The archbishop is on a short list for a larger post and behaves like it.",
    "An audit of the schools that will not survive being read."
  ],
